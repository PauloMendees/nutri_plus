NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3000
# Meta Pixel. Carregado na landing, auth e checkout com PageView; dentro do app
# autenticado entra sem PageView, só para o evento TrialAtivado poder disparar.
# Deixe vazio localmente para desligar. O par server-side (META_PIXEL_ID +
# META_CAPI_ACCESS_TOKEN) fica em apps/api/.env — o token nunca vem para cá.
NEXT_PUBLIC_META_PIXEL_ID=1633275874982739
