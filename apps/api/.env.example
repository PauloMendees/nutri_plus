DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nutri_plus?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side ONLY — never expose. Used for the Supabase Admin API (patient invites).
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
# Tokens are verified via the project's JWKS (ES256) discovered from SUPABASE_URL.
# No JWT secret is needed.
OPENAI_API_KEY=sk-placeholder-not-used-yet
PORT=3000
WEB_ORIGIN=http://localhost:3001
# Segredo do endpoint interno de disparo de lembretes (POST /v1/internal/reminders/dispatch).
# Opcional em dev; em prod deve ser setado — MESMO valor no serviço web e no cron do Render.
# Gere com: openssl rand -hex 32
REMINDER_DISPATCH_KEY=
