DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nutri_plus?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side ONLY — never expose. Used for the Supabase Admin API (patient invites).
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
# Tokens are verified via the project's JWKS (ES256) discovered from SUPABASE_URL.
# No JWT secret is needed.
OPENAI_API_KEY=sk-placeholder-not-used-yet
PORT=3000
WEB_ORIGIN=http://localhost:3001
# Segredo do endpoint interno de disparo de lembretes (POST /v1/internal/reminders/dispatch).
# Opcional em dev; em prod deve ser setado — MESMO valor no serviço web e no cron do Render.
# Gere com: openssl rand -hex 32
REMINDER_DISPATCH_KEY=

# --- Asaas (assinaturas/pagamentos) ---
# Base da API Asaas (v3). Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3. Opcional em dev (o AsaasService só é
# exigido quando checkout/webhook são usados).
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Chave de API do Asaas (painel Asaas → Integrações → Chave de API).
ASAAS_API_KEY=
# Segredo validado no header `asaas-access-token` do webhook
# (POST /v1/internal/asaas/webhook). Configure o MESMO valor no painel Asaas
# ao cadastrar a URL do webhook. Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Usado APENAS pelo script one-off de cortesia
# (pnpm --filter @nutri-plus/api run seed:subscriptions): lista de e-mails,
# separada por vírgula, cujas contas viram isentas (isComp = Pro permanente).
# NÃO é lido pela API em runtime.
COMP_NUTRITIONIST_EMAILS=

# --- Resend (pedidos de suporte do dashboard web) ---
# API key do Resend (https://resend.com). Opcional em dev; se ausente,
# POST /v1/support responde 503.
RESEND_API_KEY=
# Caixa que recebe os pedidos de suporte.
SUPPORT_INBOX_EMAIL=contato@inutri.life
# Remetente (domínio verificado no Resend). Ex.: "iNutri Suporte <suporte@inutri.life>"
SUPPORT_FROM_EMAIL=iNutri Suporte <suporte@inutri.life>

